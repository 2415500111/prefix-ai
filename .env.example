# Prefix AI environment configuration.
# Copy to .env (`cp .env.example .env`) and adjust. Never commit .env.
# Values here are for LOCAL DEVELOPMENT ONLY.

# ─── Application ────────────────────────────────────────────────────────────
# One of: development | test | staging | production.
# In production, docs/OpenAPI are disabled and placeholder secrets are rejected.
APP_ENV=development

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# json (one JSON object per line, for log shipping) | console (human-readable, for local work).
LOG_FORMAT=json

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL + pgvector) ───────────────────────────────────────
# Used by the postgres container to create the database on first start.
POSTGRES_USER=prefix
POSTGRES_PASSWORD=prefix
POSTGRES_DB=prefix

# SQLAlchemy URL for the API, worker, and Alembic when run on your machine.
# Must use the psycopg (v3) driver: postgresql+psycopg://...
# Inside Docker Compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql+psycopg://prefix:prefix@localhost:5432/prefix

# ─── Redis (Celery broker + result backend) ─────────────────────────────────
# Inside Docker Compose this is overridden to point at the `redis` service.
REDIS_URL=redis://localhost:6379/0

# ─── LLM (Claude via the official anthropic SDK) ────────────────────────────
# API key from https://console.anthropic.com. Without it, reminders are sent untranslated and
# every assistant question goes straight to a nurse.
ANTHROPIC_API_KEY=

# Claude model ID used for every LLM call. Required; never hard-coded in the code.
LLM_MODEL=claude-opus-5-5

# ─── Auth ───────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Values containing "change-me" are rejected when APP_ENV=production.
JWT_SECRET=change-me-dev-only-insecure-jwt-secret-0000000000

# Lifetimes of staff tokens. Access tokens are short; refresh tokens rotate on every use.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ─── Patient access ─────────────────────────────────────────────────────────
# Single-use magic links sent to patients, and the session they unlock.
MAGIC_LINK_TTL_MINUTES=1440
PATIENT_SESSION_TTL_MINUTES=720
# Public URL of the web app; magic links point here.
WEB_BASE_URL=http://localhost:3000

# ─── PII encryption ─────────────────────────────────────────────────────────
# AES-256-GCM keys for encrypting patient PII at rest, as "<key-id>:<base64 32-byte key>",
# comma-separated. The FIRST key encrypts new data; every listed key can decrypt.
# To rotate: put a new key first, keep the old one listed until data is re-encrypted.
# Generate a key with: uv run python -c "from prefix_api.core.crypto import generate_key; print(generate_key())"
# Key ids starting with "dev" are rejected when APP_ENV=production.
PII_ENCRYPTION_KEYS=dev1:4wwjLowACFfgPfkNbKHd-u90z0olVkf500CarD3t04o

# HMAC key for blind indexes (exact-match search on encrypted email/phone/MRN). At least 32 chars.
# Changing it requires recomputing every index. Values containing "change-me" are rejected in production.
PII_BLIND_INDEX_KEY=change-me-dev-11OwqbRpMrszwhJYh7o4oNqR8nlvT278SjpNiux7iCsjCUp-9XYGZg

# ─── Messaging (patient reminders and check-ins) ────────────────────────────
# console = log messages (masked) instead of sending them. Default for development.
# live    = Twilio for SMS and WhatsApp, SMTP for email (fill in the values below).
MESSAGING_PROVIDER=console

# Twilio (needed when MESSAGING_PROVIDER=live). Sender numbers in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Public base URL of this API as Twilio sees it; inbound webhooks are signature-checked
# against <PUBLIC_API_BASE_URL>/webhooks/twilio.
PUBLIC_API_BASE_URL=http://localhost:8000

# SMTP for email reminders (optional; email reminders fail cleanly if unset).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# How many due reminders one dispatcher run sends (runs every minute).
DISPATCH_BATCH_SIZE=100
# Seconds to wait for the LLM when translating a reminder; on timeout the approved text is sent.
TRANSLATION_TIMEOUT_SECONDS=20
# Seconds the AI Prep Assistant may take per LLM call; past this the question goes to a nurse.
ASSISTANT_TIMEOUT_SECONDS=30

# ─── Guest demo ─────────────────────────────────────────────────────────────
# Lets anyone try the synthetic demo hospital from the sign-in page. Set false in production
# unless a public demo is wanted (see docs/DEPLOYMENT.md).
ENABLE_GUEST_LOGIN=true
GUEST_SESSION_MINUTES=120

# ─── Embeddings ─────────────────────────────────────────────────────────────
# Provider used to embed approved protocol steps for retrieval.
# local = offline deterministic hashing embedder (no network, no model download).
EMBEDDING_PROVIDER=local

# ─── Web app (Next.js) ──────────────────────────────────────────────────────
# URL the Next.js server uses to call the API (server-side only; never sent to browsers).
# Inside Docker Compose this is overridden to http://api:8000.
API_INTERNAL_URL=http://localhost:8000
